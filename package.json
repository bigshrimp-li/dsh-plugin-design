{
  "name": "@local/dsh-plugin-design",
  "version": "0.1.0",
  "private": true,
  "description": "Design tools for DeepSeek Harness — validate, render and export design canvases and design systems",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "client.js",
    "skills",
    "NOTICE.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-runtime.mjs && node scripts/copy-editor-assets.mjs",
    "watch": "node scripts/watch.mjs",
    "test": "./test.sh",
    "test:browser": "npm run build && node test/editor-browser.mjs",
    "test:space": "npm run build && node --test test/editor-design-space.test.mjs && node test/design-space-browser.mjs",
    "test:runtime": "npm run build && node --test test/independence.test.mjs && node test/runtime-browser.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2"
  },
  "devDependencies": {
    "playwright-core": "^1.58.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "esbuild": "^0.28.2"
  }
}
