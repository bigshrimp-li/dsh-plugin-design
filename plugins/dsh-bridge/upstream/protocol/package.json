{
  "name": "@super-agent/protocol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cross-process protocol for the Core service: protocol version, request headers, routes, error vocabulary, views and events. No runtime dependencies.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./idl/openapi.yaml": "./idl/openapi.yaml",
    "./idl/asyncapi.yaml": "./idl/asyncapi.yaml"
  },
  "files": [
    "dist",
    "idl"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  }
}
