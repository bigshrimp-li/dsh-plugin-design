{
  "name": "@local/okr-schedule",
  "version": "3.2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "src/host/",
    "src/client/",
    "bin/",
    "scripts/check.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "slots",
        "layout"
      ]
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "npm run check",
    "check": "node scripts/check.mjs",
    "test": "node scripts/test.mjs",
    "test:host": "node scripts/host-probe.mjs",
    "test:browser": "node scripts/test.mjs --browser",
    "test:host:browser": "node scripts/calendar-host-browser.mjs"
  },
  "bin": {
    "okr-space": "./bin/okr-space.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright-core": "1.64.1",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  }
}
